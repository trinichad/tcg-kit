{
  "name": "@holo/tcg-kit",
  "version": "0.1.2",
  "description": "TCG card pricing, recognition, and catalog kit \u2014 reusable across Holo Hunting apps.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./pricing": {
      "types": "./dist/pricing/index.d.ts",
      "import": "./dist/pricing/index.js",
      "require": "./dist/pricing/index.cjs"
    },
    "./recognize": {
      "types": "./dist/recognize/index.d.ts",
      "import": "./dist/recognize/index.js",
      "require": "./dist/recognize/index.cjs"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js",
      "require": "./dist/catalog/index.cjs"
    },
    "./data/*": "./data/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "canary": "tsx scripts/canary.ts",
    "battery": "tsx scripts/battery.ts",
    "build-index": "tsx scripts/build-index.ts",
    "update-index": "tsx scripts/build-index.ts --report-dir .tmp/index-report",
    "index-check": "tsx scripts/index-check.ts",
    "copy-index": "tsx scripts/copy-index.ts",
    "probes": "tsx scripts/probes.ts",
    "demo": "tsx scripts/demo-price.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "jpeg-js": "^0.4.4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
